  "roles": {
    "primary": {
      "displayName": "Primary LLM",
      "description": "Main conversational model \u2014 handles all user interactions",
      "configKey": "agents.defaults.model.primary",
      "requiredCapabilities": [
        "llm",
        "tools"
      ],
      "recommendedCapabilities": [
        "vision",
        "code",
        "reasoning"
      ]
    },
    "fallback": {
      "displayName": "LLM Fallback",
      "description": "Backup models used when primary fails (in order)",
      "configKey": "agents.defaults.model.fallbacks",
      "requiredCapabilities": [
        "llm",
        "tools"
      ]
    },
    "image": {
      "displayName": "Image Model",
      "description": "Handles vision/image processing when primary can't",
      "configKey": "agents.defaults.imageModel.primary",
      "requiredCapabilities": [
        "vision"
      ]
    },
    "heartbeat": {
      "displayName": "Heartbeat",
      "description": "Low-cost model for periodic polling checks",
      "configKey": "agents.defaults.heartbeat.model",
      "requiredCapabilities": [
        "llm"
      ],
      "preferCostTier": [
        "very-low",
        "low",
        "free"
      ]
    },
    "coding": {
      "displayName": "Coding Agent",
      "description": "Model used when spawning coding sub-agents",
      "configKey": "session_spawn.model",
      "requiredCapabilities": [
        "llm",
        "code"
      ]
    }
  },
